# Discord 봇 토큰 (Developer Portal > Bot > Token)
DISCORD_TOKEN=
# (선택) 관리자 채널 ID — 수집기 멈춤/복구, 처리 오류 알림
ADMIN_CHANNEL_ID=

# 컨테이너 실행 계정 — safety-collector/.env 의 PUID/PGID 와 같은 값 (NAS 에서 `id <사용자>` 로 확인)
# 수집기 DB 폴더(/volume1/docker/safety-collector/data)는 docker-compose.yml 에 적혀 있음 → 컨테이너 안 /data
PUID=1000
PGID=1000

# 재난문자 공지 끄기 (기본: 켜짐)
# DISASTER_ENABLED=false
# PEWS 실시간 감지(비공식)로 지진을 공식 발표보다 먼저 공지 (기본: 꺼짐)
# PEWS_ENABLED=true

# (선택) 이 시간(분)보다 오래된 항목은 공지하지 않음 (기본 30)
# STALE_MINUTES=30
