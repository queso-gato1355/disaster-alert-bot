# ===== 필수 =====
DISCORD_TOKEN=

# ===== 공용 수집기(safety-collector) DB =====
# NAS 실제 폴더: /volume1/docker/safety-collector/data  (compose 가 컨테이너 안 /data 로 연결)
# SAFETY_DB 는 컨테이너 '안'에서 본 경로라 /data/safety.db 가 맞습니다. 보통 바꿀 필요 없음
SAFETY_DATA_DIR=/volume1/docker/safety-collector/data
# SAFETY_DB=/data/safety.db

# 컨테이너 실행 계정 — safety-collector/.env 의 PUID/PGID 와 같은 값 (NAS 에서 `id <사용자>` 로 확인)
PUID=1000
PGID=1000

# ===== 선택 =====
# 관리자 알림 채널 ID (개발자 모드 → 채널 우클릭 → ID 복사)
ADMIN_CHANNEL_ID=
# DISASTER_ENABLED=false
# PEWS_ENABLED=true
# STALE_MINUTES=30
